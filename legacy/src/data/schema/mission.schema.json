{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mancermundo.dev/schemas/mission.schema.json",
  "title": "Mission",
  "description": "One record per crit op. Map geometry (drop zones, territories, centreline, neutral edges) lives here; terrain and objective spots live in the killzone layout, keyed by map id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "pack", "critOp", "critOpRoll", "turningPoints", "equipmentLimit", "killOp", "actions", "scoring", "objectiveSetup", "maps", "text", "source"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/Id" },
    "name": { "type": "string", "minLength": 1 },
    "pack": { "$ref": "common.schema.json#/$defs/Slug" },
    "critOp": { "$ref": "common.schema.json#/$defs/Slug" },
    "critOpRoll": { "type": "integer", "minimum": 1, "description": "D3 result that selects this crit op." },
    "turningPoints": { "type": "integer", "minimum": 1 },
    "equipmentLimit": { "type": "integer", "minimum": 0, "description": "Equipment options each team may select." },
    "killOp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gradeTable", "clamp"],
      "properties": {
        "gradeTable": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[0-9]+$" },
          "additionalProperties": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": { "type": "integer", "minimum": 1 }
          },
          "description": "Key = enemy starting operatives (non-Expendable); value = incapacitations needed for grades 1..5."
        },
        "clamp": { "type": "boolean", "description": "Starting counts outside the table use the nearest row." }
      }
    },
    "actions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Id" } },
    "scoring": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ScoringRule" } },
    "objectiveSetup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markerMm", "steps"],
      "properties": {
        "markerMm": { "type": "integer", "minimum": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["by", "constraints"],
            "properties": {
              "by": { "enum": ["initiative", "other"], "description": "initiative = player with setup initiative." },
              "constraints": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "onCentreline": { "type": "boolean" },
                  "whollyWithinTerritory": { "type": "boolean" },
                  "differentTerritoryFromPrevious": { "type": "boolean" },
                  "withinCentrelineInches": { "$ref": "common.schema.json#/$defs/Inches" },
                  "minFromOtherMarkers": { "$ref": "common.schema.json#/$defs/Inches" },
                  "minFromNeutralEdges": { "$ref": "common.schema.json#/$defs/Inches" }
                }
              }
            }
          }
        }
      }
    },
    "maps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Map" } },
    "text": { "$ref": "common.schema.json#/$defs/Text" },
    "source": { "$ref": "common.schema.json#/$defs/Source" }
  },
  "$defs": {
    "ScoringRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "window", "metric", "cmp", "vp", "text"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/Slug" },
        "op": { "enum": ["kill", "crit"] },
        "window": { "$ref": "common.schema.json#/$defs/WindowSet" },
        "fromTurningPoint": { "type": "integer", "minimum": 1 },
        "metric": {
          "enum": ["killGradeIncreased", "killGrade", "securedMarkers", "transmittingMarkersControlled", "lootPerformed"]
        },
        "cmp": { "enum": ["event", "gte", "gtEnemy"] },
        "value": { "type": "integer", "minimum": 0 },
        "vp": { "type": "integer", "minimum": 1 },
        "maxPerTurningPoint": { "type": "integer", "minimum": 1, "description": "Cap on VP for this rule and its capGroup in one TP." },
        "capGroup": { "$ref": "common.schema.json#/$defs/Slug" },
        "maxPerBattle": { "type": "integer", "minimum": 1 },
        "text": { "$ref": "common.schema.json#/$defs/Text" }
      }
    },
    "Map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "mapRoll", "playerEdges", "dropZones", "territories", "centreline", "neutralEdges", "centrePoint"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/Slug" },
        "name": { "type": "string", "minLength": 1 },
        "mapRoll": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "description": "D6 range that selects this map.",
          "properties": { "min": { "type": "integer", "minimum": 1, "maximum": 6 }, "max": { "type": "integer", "minimum": 1, "maximum": 6 } }
        },
        "playerEdges": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B"],
          "description": "Killzone edge owned by each seat, as a segment.",
          "properties": { "A": { "$ref": "#/$defs/Segment" }, "B": { "$ref": "#/$defs/Segment" } }
        },
        "dropZones": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B"],
          "properties": { "A": { "$ref": "common.schema.json#/$defs/Polygon" }, "B": { "$ref": "common.schema.json#/$defs/Polygon" } }
        },
        "territories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B"],
          "properties": { "A": { "$ref": "common.schema.json#/$defs/Polygon" }, "B": { "$ref": "common.schema.json#/$defs/Polygon" } }
        },
        "centreline": { "$ref": "#/$defs/Segment" },
        "neutralEdges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Segment" } },
        "centrePoint": { "$ref": "common.schema.json#/$defs/Vec2" }
      }
    },
    "Segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b"],
      "properties": { "a": { "$ref": "common.schema.json#/$defs/Vec2" }, "b": { "$ref": "common.schema.json#/$defs/Vec2" } }
    }
  }
}
