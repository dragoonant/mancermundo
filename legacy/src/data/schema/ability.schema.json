{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mancermundo.dev/schemas/ability.schema.json",
  "title": "Ability, unique action, faction rule or team-local weapon rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "text", "source"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/Id" },
    "kind": { "enum": ["ability", "uniqueAction", "weaponRule", "factionRule", "archetype"] },
    "name": { "type": "string", "minLength": 1 },
    "team": { "$ref": "common.schema.json#/$defs/Id" },
    "ap": { "type": "integer", "minimum": 0, "description": "AP cost of a unique action." },
    "keywords": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Keyword" } },
    "conditions": { "$ref": "common.schema.json#/$defs/Condition", "description": "Requirements to perform a unique action." },
    "target": { "$ref": "common.schema.json#/$defs/TargetSpec", "description": "Target of a unique action, when it picks one." },
    "window": { "$ref": "common.schema.json#/$defs/WindowSet", "description": "Trigger window of a passive ability." },
    "when": { "$ref": "common.schema.json#/$defs/Condition" },
    "effect": { "$ref": "common.schema.json#/$defs/EffectList" },
    "limit": { "$ref": "common.schema.json#/$defs/Limit" },
    "scope": { "$ref": "common.schema.json#/$defs/TargetSpec", "description": "Which operatives the ability affects; defaults to the bearer." },
    "choiceGroup": {
      "$ref": "common.schema.json#/$defs/Slug",
      "description": "Abilities sharing a choiceGroup can be picked by the team's teamChoices (for example chapter-tactic)."
    },
    "weaponRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["param"],
      "description": "For kind weaponRule: how a weapon uses this team-local rule.",
      "properties": {
        "param": { "enum": ["none", "inches", "count", "target"] },
        "critsVariant": { "type": "boolean" },
        "distanceVariant": { "type": "boolean" },
        "moveRestriction": { "type": "boolean" }
      }
    },
    "text": { "$ref": "common.schema.json#/$defs/Text" },
    "source": { "$ref": "common.schema.json#/$defs/Source" }
  },
  "if": { "properties": { "kind": { "const": "weaponRule" } }, "required": ["kind"] },
  "then": { "required": ["weaponRule"] }
}
