{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mancermundo.dev/schemas/ploy.schema.json",
  "title": "Ploy",
  "description": "Strategy ploys are STRATEGIC GAMBITs by definition. window is when the ploy is played; a persistent effect names its own trigger.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "type", "cost", "window", "effect", "text", "source"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/Id" },
    "name": { "type": "string", "minLength": 1 },
    "team": { "$ref": "common.schema.json#/$defs/Id" },
    "type": { "enum": ["strategy", "firefight"] },
    "cost": { "type": "integer", "minimum": 0 },
    "window": { "$ref": "common.schema.json#/$defs/WindowSet" },
    "when": { "$ref": "common.schema.json#/$defs/Condition" },
    "effect": { "$ref": "common.schema.json#/$defs/EffectList" },
    "limit": { "$ref": "common.schema.json#/$defs/Limit", "description": "Defaults to oncePerTurningPoint." },
    "text": { "$ref": "common.schema.json#/$defs/Text" },
    "source": { "$ref": "common.schema.json#/$defs/Source" }
  }
}
