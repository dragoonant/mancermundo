{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mancermundo.dev/schemas/datacard.schema.json",
  "title": "Operative datacard",
  "description": "Weapon references in weapons.fixed and in any slot may be a weapon profile id or a profileGroup id (a group brings every profile that carries it).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "team", "stats", "base", "keywords", "weapons", "abilities", "uniqueActions", "figure", "text", "source"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/Id" },
    "name": { "type": "string", "minLength": 1 },
    "team": { "$ref": "common.schema.json#/$defs/Id" },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apl", "move", "save", "wounds"],
      "properties": {
        "apl": { "type": "integer", "minimum": 1 },
        "move": { "$ref": "common.schema.json#/$defs/Inches" },
        "save": { "$ref": "common.schema.json#/$defs/RollTarget" },
        "wounds": { "type": "integer", "minimum": 1 }
      }
    },
    "base": { "type": "integer", "minimum": 20, "description": "Base diameter in mm." },
    "keywords": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/Keyword" } },
    "weapons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixed"],
      "properties": {
        "fixed": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Id" } },
        "options": { "type": "array", "items": { "$ref": "#/$defs/LoadoutSlot" } }
      }
    },
    "abilities": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Id" } },
    "uniqueActions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Id" } },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archetype"],
      "properties": {
        "archetype": { "type": "string", "pattern": "^[a-z][a-z0-9]*-[a-z0-9-]+$" },
        "variant": { "$ref": "common.schema.json#/$defs/Slug" }
      }
    },
    "expendable": { "type": "boolean", "description": "Ignored for the opponent's kill op, both as a casualty and in the starting count." },
    "nonOperativeForSelection": { "type": "boolean" },
    "text": { "$ref": "common.schema.json#/$defs/Text" },
    "source": { "$ref": "common.schema.json#/$defs/Source" }
  },
  "$defs": {
    "LoadoutSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "description": "Either a pick-from-list slot (from) or a choice between mutually exclusive sets (sets). Slot ids are unique within a datacard; a sets slot is answered with the chosen set id.",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/Slug" },
        "label": { "type": "string", "minLength": 1 },
        "pick": { "type": "integer", "minimum": 0, "description": "How many to choose from; default 1." },
        "min": { "type": "integer", "minimum": 0, "description": "Minimum chosen; default equals pick." },
        "from": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/Id" } },
        "sets": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/LoadoutSet" } }
      },
      "oneOf": [{ "required": ["from"] }, { "required": ["sets"] }]
    },
    "LoadoutSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/Slug" },
        "name": { "type": "string", "minLength": 1 },
        "fixed": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Id" } },
        "options": { "type": "array", "items": { "$ref": "#/$defs/LoadoutSlot" } }
      }
    }
  }
}
